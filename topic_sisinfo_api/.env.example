# Wrangler reads these from `wrangler secret put`, not from this file.
# This file documents the names that every worker expects.
#
# For local dev with `wrangler dev`, copy to workers/<name>/.dev.vars and fill in.

TURSO_URL=
TURSO_TOKEN=
RESEND_API_KEY=
HMAC_SECRET=
ADMIN_TOKEN=

# Optional. Without it Socrata enforces lower per-IP rate limits.
# Get one from https://evergreen.data.socrata.com/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# Comma-separated list. Supports literal origins and the special token `*.vercel.app`.
ALLOWED_ORIGINS=http://localhost:3000

# Optional. Slack or Discord incoming webhook for the daily quota report.
# If unset, /admin/stats still works; just no proactive Slack/Discord alerts.
QUOTA_WEBHOOK_URL=
